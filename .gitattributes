# Store large binary 3D assets with Git LFS.
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
# Native Unreal assets are binary source assets, not build output.
unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text
unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text
unreal/Art/WindowInteriors/*.png filter=lfs diff=lfs merge=lfs -text
unreal/Art/Lookdev/*.png filter=lfs diff=lfs merge=lfs -text
